@model DoctorQueryVM


<nav aria-label="Page navigation example">
  <ul class="pagination">
    <li class="page-item">
        <a class="page-link page-js-link" data-page="@Model.PreviousPage">Previous</a>
    </li>
    
    @for (int pageNum = 1; pageNum <= Model.TotalPages; pageNum++)
    {
        <li class="page-item @(Model.Page == pageNum ? "active" : "")">
            <a class="page-link page-js-link" data-page="@pageNum">@pageNum</a>
        </li>
    }

    <li class="page-item">
        <a class="page-link page-js-link" data-page="@Model.NexPage">Next</a>
    </li>
  </ul>
</nav>
