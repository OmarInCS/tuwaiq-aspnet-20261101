@model DoctorQueryVM


<form id="doctor-serach-form">
    <div class="row">
        <div class="col">
            <div class="form-floating mb-3">
                <input class="form-control" asp-for="Name">
                <label asp-for="Name"></label>
            </div>
        </div>
        <div class="col">
            <div class="form-floating mb-3">
                <input class="form-control" asp-for="Id">
                <label asp-for="Id"></label>
            </div>
        </div>
        <div class="col">
            <div class="form-floating mb-3">
                <input type="date" class="form-control" asp-for="HireDateStart">
                <label asp-for="HireDateStart"></label>
            </div>
        </div>
        <div class="col">
            <div class="form-floating mb-3">
                <input type="date" class="form-control" asp-for="HireDateEnd">
                <label asp-for="HireDateEnd"></label>
            </div>
        </div>

        <input asp-for="Page" class="visually-hidden" />

        <div class="col">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>
