@model DoctorCreateVM

@{
    ViewData["Title"] = "Create Doctor";
}

<h3>Create Doctor</h3>

<form method="post">
    <div class="form-floating mb-3">
        <input class="form-control" asp-for="Name">
        <label asp-for="Name"></label>
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="form-floating  mb-3">
        <input class="form-control" asp-for="Salary">
        <label asp-for="Salary"></label>
        <span class="text-danger" asp-validation-for="Salary"></span>
    </div>
    <div class="form-floating  mb-3">
        <input type="date" class="form-control" asp-for="HireDate">
        <label asp-for="HireDate"></label>
        <span class="text-danger" asp-validation-for="HireDate"></span>
    </div>
    <div class="form-floating  mb-3">
        <select asp-for="SpecialityId" class="form-select" 
                asp-items='new SelectList(Model.AllSpecialities, "Id", "Name")'>
            <option value=""></option>
        </select>
        <label asp-for="SpecialityId"></label>
        <span class="text-danger" asp-validation-for="SpecialityId"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}