@model DoctorFilteredListVM

@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between mb-3">
    <h3>Doctors @Model.Doctors.Count</h3>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</div>

<form>
    <div class="row">
        <div class="col">
            <div class="form-floating mb-3">
                <input class="form-control" asp-for="Query.Name">
                <label asp-for="Query.Name"></label>
            </div>
        </div>
        <div class="col">
            <div class="form-floating mb-3">
                <input class="form-control" asp-for="Query.Id">
                <label asp-for="Query.Id"></label>
            </div>
        </div>
        <div class="col">
            <div class="form-floating mb-3">
                <input type="date" class="form-control" asp-for="Query.HireDateStart">
                <label asp-for="Query.HireDateStart"></label>
            </div>
        </div>
        <div class="col">
            <div class="form-floating mb-3">
                <input type="date" class="form-control" asp-for="Query.HireDateEnd">
                <label asp-for="Query.HireDateEnd"></label>
            </div>
        </div>
        <div class="col">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Hire Date</th>
        <th></th>
    </tr>
    @foreach (var d in Model.Doctors)
    {
        <tr>
            <td>@d.Id</td>
            <td>
                <a asp-controller="Doctor" asp-action="Details" asp-route-id="@d.Id">
                    @d.Name
                </a>
            </td>
            <td>
                @d.FormattedHireDate
            </td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Update" asp-route-id="@d.Id">
                    Update
                </a>
                <a class="btn btn-sm btn-danger btn-js-delete" data-id="@d.Id">
                    Delete
                </a>
            </td>
        </tr>
    }
</table>

@section Scripts {
    <script>
        $(".btn-js-delete").on("click", function() {
            var doctorId = $(this).data("id");
            var isConfirmed = confirm("Are you sure to delete doctor #" + doctorId);

            if (isConfirmed) {
                $.ajax({
                    url: "Doctor/Delete/" + doctorId,
                    success: () => {
                        $(this).parents("tr").remove();
                    }
                });
            }
        });
    </script>
}