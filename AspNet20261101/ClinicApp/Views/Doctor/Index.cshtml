@model List<Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between mb-3">
    <h3>Doctors @Model.Count</h3>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</div>

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Hire Date</th>
        <th></th>
    </tr>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.Id</td>
            <td>
                <a asp-controller="Doctor" asp-action="Details" asp-route-id="@d.Id">
                    @d.Name
                </a>
            </td>
            <td>
                @d.HireDate.ToShortDateString()
            </td>
            <td>
                <a class="btn btn-sm btn-danger btn-js-delete" data-id="@d.Id">
                    Delete
                </a>
            </td>
        </tr>
    }
</table>

@section Scripts {
    <script>
        $(".btn-js-delete").on("click", function() {
            var doctorId = $(this).data("id");
            var isConfirmed = confirm("Are you sure to delete doctor #" + doctorId);

            if (isConfirmed) {
                $.ajax({
                    url: "Doctor/Delete/" + doctorId,
                    success: () => {
                        $(this).parents("tr").remove();
                    }
                });
            }
        });
    </script>
}